{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aw-app.schema.json",
  "title": "aw-app.json manifest (v1)",
  "description": "Minimal structural validator for the Decoupled Apps Framework manifest (docs/knowledge_base/docs/architecture/decoupled-apps-framework.md, Decision 2). Not the framework's eventual canonical schema — a local stand-in until Phase 1 publishes schemas/aw-app.schema.json for real.",
  "type": "object",
  "required": ["manifest_version", "id", "name", "version", "tier", "runtime", "permissions", "contributes"],
  "properties": {
    "manifest_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "tier": { "enum": ["inprocess", "container"] },
    "runtime": {
      "type": "object",
      "properties": {
        "python": { "type": "string" },
        "entrypoint": { "type": "string" },
        "pip_requires": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "port": { "type": "integer" },
        "standalone": {
          "type": "object",
          "description": "ADR Decision 4 (adr-app-front-back-routes-dual-mode.md) — optional, tolerated forward-compatibly. Declares this app is runnable via `python -m <module>` outside the workspace runtime.",
          "required": ["module", "default_port"],
          "properties": {
            "module": { "type": "string", "minLength": 1 },
            "default_port": { "type": "integer", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(routes:register|db:own-tables|commands:install|service:manage|watchdog:tasks|notifications:send|containers:manage|config:extend:[a-z0-9-]+|net:outbound|fs:workspace-data|fs:workspace-read|secrets:own|ui:code|ui:slots:[a-z0-9.:_-]+)$"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "routes": { "type": "array" },
        "commands": { "type": "array" },
        "system_clis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "installer"],
            "properties": {
              "name": { "type": "string" },
              "installer": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "body"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Namespaced window id, e.g. browser.main. Runtime validators enforce the <app-id>. prefix."
              },
              "title": { "type": "string" },
              "icon": { "type": "string" },
              "body": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "enum": ["managed_app", "declarative", "component"],
                    "description": "managed_app means the app declares intent only; aw-frontend owns chrome/layout and framework settings, while aw-workspace owns lifecycle/access behavior. declarative renders a windows/*.json widget spec. component is reserved for trusted code-backed windows."
                  },
                  "kind": {
                    "enum": ["browser", "web", "tool", "settings", "dashboard"],
                    "description": "Frontend rendering hint for managed_app windows."
                  },
                  "path": {
                    "type": "string",
                    "description": "Optional path/query on the app subdomain for managed_app windows."
                  },
                  "app_id": {
                    "type": "string",
                    "description": "Optional target app id; defaults to the contributing app id."
                  },
                  "spec": {
                    "type": "string",
                    "description": "Path to a declarative windows/*.json spec, only for body.type=declarative."
                  },
                  "spec_data": {
                    "type": "object",
                    "description": "Runtime-inlined declarative spec returned by GET /api/apps/-/contributions."
                  }
                }
              }
            }
          }
        },
        "nav": { "type": "array" },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "settings_panels": { "type": "array" },
        "frontend": { "type": "object" },
        "services": { "type": "array" },
        "containers": { "type": "array" },
        "extension_points": { "type": "array" },
        "extensions": { "type": "array" },
        "mcp": {
          "type": "object",
          "description": "MCP-related declarations. `provides` is the marketplace What-you-get tool list (informational only). `reload_on_save: true` means this app ships its own root mcp.json (scanned directly by aw-mcp-gateway's app-scan) — a config save then calls the installed mcp-gateway app's POST /reload after your plugin's on_config_saved hook runs. See skills/aw-create-app/SKILL.md §4/§2.",
          "properties": {
            "provides": { "type": "array" },
            "reload_on_save": { "type": "boolean" }
          }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" }
      }
    },
    "dependencies": { "type": "object" },
    "migrations": { "type": "object" }
  }
}
